# TypeSafe Jev - the decider (operation + target). Early access key.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# OpenRouter (or any OpenAI-compatible endpoint) - writes text only for TYPE_TEXT.
# Cheap options: deepseek/deepseek-chat, moonshotai/kimi-k2
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=deepseek/deepseek-chat
TEXT_MODEL_REASONING=none

# Browser: reuse a real Chrome profile so logins persist (login once by hand).
# Leave empty to launch a throwaway Chromium.
JIFFY_USER_DATA_DIR=
JIFFY_CHANNEL=chrome
JIFFY_HEADLESS=false

# Or attach to your already-running Chrome (keeps every existing login/tab).
# Start Chrome first:  chrome --remote-debugging-port=9222
JIFFY_CDP_URL=

# Logging: quiet | normal | verbose
JIFFY_LOG=normal

# Stop and ask the user when Jev is less sure than this.
JIFFY_CONFIDENCE_FLOOR=0.5
JIFFY_MAX_STEPS=60

# Optional: personal facts used to fill fields (see profile.example.yaml).
JIFFY_PROFILE=
